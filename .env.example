# Copy to .env. Never commit real credentials. Generate independent keys with scripts/secrets.mjs.
BASE_URL=https://mail.example.com
PORT=3000
DATABASE_URL=postgresql://anymail:replace-with-url-encoded-password@localhost:5432/anymail
POSTGRES_PASSWORD=replace-with-random-hex-password
ENCRYPTION_KEY=replace-with-base64-32-byte-key
OIDC_ISSUER=https://identity.example.com/realms/anymail
OIDC_AUDIENCE=https://mail.example.com/mcp
OIDC_CLIENT_ID=anymail-web
OIDC_CLIENT_SECRET=replace-with-web-client-secret
ALLOWED_CLIENT_IDS=anymail-web,anymail-chatgpt
# Exact administrator-approved host:port pairs for enterprise networks or Proton Bridge.
PRIVATE_ENDPOINTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Bound per-worker IDLE capacity; 0 disables native IMAP listeners. Periodic sync remains active.
IMAP_IDLE_CONNECTIONS=8
# Exact canonical HTTPS origins permitted to receive JMAP account tokens; administrator only.
JMAP_ALLOWED_ORIGINS=
# Select global, usgov, usgovdod, or china before registering Microsoft OAuth.
MICROSOFT_CLOUD=global
# Optional Gmail Pub/Sub. Set both with an authenticated push subscription.
# Leave commented until configured; topic must belong to the OAuth app's Google project.
# GMAIL_PUSH_TOPIC=projects/your-project/topics/your-topic
# GMAIL_PUSH_IDENTITY=pubsub@your-project.iam.gserviceaccount.com
