{
  "realm": "anymail",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "clientScopes": [
    {"name":"mail.read","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}},
    {"name":"mail.write","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}},
    {"name":"mail.send","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}}
  ],
  "clients": [
    {
      "clientId": "anymail-web", "enabled": true, "protocol": "openid-connect", "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}", "standardFlowEnabled": true, "directAccessGrantsEnabled": false,
      "redirectUris": ["${BASE_URL}/auth/callback"], "webOrigins": ["${BASE_URL}"],
      "attributes": {"pkce.code.challenge.method":"S256"},
      "optionalClientScopes": ["mail.read","mail.write","mail.send"],
      "protocolMappers": [
        {"name":"mail-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","config":{"included.custom.audience":"${BASE_URL}/mcp","access.token.claim":"true"}},
        {"name":"tenant","protocol":"openid-connect","protocolMapper":"oidc-hardcoded-claim-mapper","config":{"claim.name":"tenant_id","claim.value":"${ANYMAIL_TENANT_ID}","jsonType.label":"String","access.token.claim":"true"}}
      ]
    },
    {
      "clientId": "anymail-chatgpt", "enabled": true, "protocol": "openid-connect", "publicClient": true,
      "standardFlowEnabled": true, "directAccessGrantsEnabled": false,
      "redirectUris": ["${CHATGPT_REDIRECT_URI}"], "attributes": {"pkce.code.challenge.method":"S256"},
      "optionalClientScopes": ["mail.read","mail.write","mail.send"],
      "protocolMappers": [
        {"name":"mail-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper","config":{"included.custom.audience":"${BASE_URL}/mcp","access.token.claim":"true"}},
        {"name":"tenant","protocol":"openid-connect","protocolMapper":"oidc-hardcoded-claim-mapper","config":{"claim.name":"tenant_id","claim.value":"${ANYMAIL_TENANT_ID}","jsonType.label":"String","access.token.claim":"true"}}
      ]
    }
  ]
}
